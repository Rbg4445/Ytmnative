{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTM Native",
  "version": "7.0.0",
  "identifier": "com.ytmnative.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YTM Native",
        "width": 1240,
        "height": 780,
        "minWidth": 860,
        "minHeight": 540,
        "transparent": true,
        "decorations": true,
        "windowEffects": {
          "effects": ["micaDark"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
